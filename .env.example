# CalmWay environment template. Safe to commit; never add real tokens here.

# Frontend (copy the relevant values to frontend/.env)
VITE_API_BASE_URL=http://localhost:8000
VITE_HOME_ROUTE=/home
VITE_MAPBOX_PUBLIC_TOKEN=
VITE_AVOID_BUSY_MAX_PREFERRED_SCORE=50
VITE_PREFER_QUIETER_MAX_PREFERRED_SCORE=75
VITE_FLEXIBLE_MAX_PREFERRED_SCORE=90

# Backend (copy the relevant values to backend/.env or the process environment)
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_TIMEZONE=Australia/Melbourne
# Copy to an ignored .env or backend/.env file, or set in the process environment.
DATABASE_URL=postgresql+psycopg://epic1:epic1@localhost:5432/epic1
MAPBOX_ACCESS_TOKEN=
MAPBOX_DIRECTIONS_PROFILE=mapbox/walking

# Authoritative handoff configuration
AVOID_BUSY_MAX_PREFERRED_SCORE=50
PREFER_QUIETER_MAX_PREFERRED_SCORE=75
FLEXIBLE_MAX_PREFERRED_SCORE=90
MAX_SPATIAL_SUPPORT_RADIUS_M=300
CORE_SPATIAL_SUPPORT_RADIUS_M=250
SPATIAL_WEIGHT_METHOD=inverse_distance
SPATIAL_WEIGHT_POWER=1
SPATIAL_DISTANCE_FLOOR_M=1
ROUTE_SAMPLE_INTERVAL_M=50
MINIMUM_ROUTE_CROWD_COVERAGE_PCT=55

# City of Melbourne ingestion settings
CITY_DATA_BASE_URL=https://data.melbourne.vic.gov.au/api/explore/v2.1
CITY_DATA_TIMEOUT_SECONDS=30
CITY_MINUTE_DATASET_ID=pedestrian-counting-system-past-hour-counts-per-minute
CITY_HOURLY_DATASET_ID=pedestrian-counting-system-monthly-counts-per-hour
CITY_SENSOR_DATASET_ID=pedestrian-counting-system-sensor-locations
MINUTE_INGESTION_INTERVAL_MINUTES=15
SOURCE_CACHE_STALE_AFTER_MINUTES=
